# Frontend (Vite / Cloudflare Pages) environment — copy to .env for local dev.
#
# VITE_API_BASE_URL is inlined at build time by Vite.
#
# Local dev (same-origin proxy via Vite dev server):
#   VITE_API_BASE_URL=/api
#
# Production with Cloudflare Pages API proxy (recommended — see deployment.md Appendix A):
#   VITE_API_BASE_URL=/api      ← proxy rewrites /api/* to the Render backend
#
# Production without proxy (cross-origin, cookie auth will be blocked by browsers):
#   VITE_API_BASE_URL=https://sakhisetu-api.onrender.com/api
#
VITE_API_BASE_URL=/api

# Dev server proxy target (used only by `npm run dev`, never in production builds).
API_PROXY_TARGET=http://localhost:4000
