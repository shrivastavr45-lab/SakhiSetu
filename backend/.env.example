PDF_FONT_PATH=/absolute/path/to/NotoSansDevanagari-Regular.ttf
PII_ENCRYPTION_KEY=replace-with-64-hex-characters
TRUST_NAME=SakhiSetu Demo Trust
TRUST_ADDRESS=Bhopal, Madhya Pradesh
TRUST_PAN=NOT-CONFIGURED-DEMO
TRUST_80G_REGISTRATION=NOT-CONFIGURED-DEMO
