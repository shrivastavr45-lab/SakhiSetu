generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DONOR
  ADMIN
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentProvider {
  MOCK
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(DONOR)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  donations    Donation[]

  @@index([role, createdAt])
}

model Scheme {
  id                 String   @id
  code               String?  @unique
  need               String
  nameHi             String
  nameEn             String
  deptHi             String
  deptEn             String
  shortHi            String
  shortEn            String
  benefitHi          String
  benefitEn          String
  eligibility        Json
  documents          Json
  steps              Json
  rules              Json
  districts          Json
  sourceUrl          String?
  officialNoticeText String?
  lastCheckedAt      DateTime?
  published          Boolean  @default(false)
  aiSummaryDraftHi   String?
  aiSummaryApproved  Boolean  @default(false)
  aiSummaryUpdatedAt DateTime?
  /// Deduplication key from the myScheme portal slug (e.g. "pm-kisan"). Null for manually-created schemes.
  myschemeSlug       String?  @unique
  /// Government level: "Central Government" or "State Government". Null for manually-created schemes.
  level              String?
  /// Canonical myScheme portal page URL for traceability.
  myschemeUrl        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([published, need])
  @@index([lastCheckedAt])
  @@index([level])
}

model Campaign {
  id          String     @id
  titleHi     String
  titleEn     String
  storyHi     String
  storyEn     String
  district    String
  goalAmount  Decimal    @db.Decimal(14, 2)
  raisedSeed  Decimal    @default(0) @db.Decimal(14, 2)
  donorSeed   Int        @default(0)
  impactHi    String
  impactEn    String
  emoji       String
  active      Boolean    @default(true)
  donations   Donation[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([active, district])
}

model Donation {
  id               String             @id @default(cuid())
  userId           String?
  campaignId       String
  donorName        String
  donorEmail       String
  donorPanCipher   String?
  donorPanLast4    String?
  amount           Decimal            @db.Decimal(14, 2)
  currency         String             @default("INR")
  frequency        DonationFrequency
  status           DonationStatus
  paymentProvider  PaymentProvider    @default(MOCK)
  idempotencyKey   String             @unique
  requestHash      String
  paymentReference String             @unique
  testMode         Boolean            @default(true)
  paidAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign         Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  payment          PaymentTransaction?
  receipt          Receipt?

  @@index([userId, createdAt(sort: Desc)])
  @@index([campaignId, status, paidAt])
  @@index([status, createdAt])
}

model PaymentTransaction {
  id          String          @id @default(cuid())
  donationId  String          @unique
  provider    PaymentProvider @default(MOCK)
  providerRef String          @unique
  status      DonationStatus
  testMode    Boolean         @default(true)
  detail      Json
  createdAt   DateTime        @default(now())
  donation    Donation        @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model Receipt {
  id             String   @id @default(cuid())
  donationId     String   @unique
  receiptNumber  String   @unique
  accessTokenHash String
  generatedAt    DateTime @default(now())
  donation       Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([generatedAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  adminEmail  String
  action      String
  targetType  String?
  targetId    String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([adminEmail, createdAt(sort: Desc)])
}
